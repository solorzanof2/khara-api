# Allow only build inputs and reviewed runtime migrations into the context.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!tsconfig.build.json
!src/
!src/**
!migrations/
!migrations/01-initial-schema.sql
!migrations/02-indexation.sql
!migrations/03-add-roles.sql
!migrations/06-create-invitations-table.sql

# Defense in depth, including nested files in otherwise allowed directories.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.git
**/node_modules
**/dist
**/lib
**/build
**/coverage
**/.cache
**/.pnpm-store
**/.config
**/.npmrc
**/logs
**/*.log
**/*.tsbuildinfo
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/credentials*
**/secrets*
**/dumps
**/backups
**/*.dump
**/*.bak
**/*.sqlite*
**/*.sql.gz
**/*.sql.zip
migrations/04-add-superuser.sql
migrations/05-add-felixouser.sql
